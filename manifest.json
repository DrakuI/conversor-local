{
  "manifest_version": 3,
  "key": "",
  "name": "Conversor Local",
  "version": "2.0.0",
  "description": "Extrai mídia de páginas e converte arquivos, 100% na sua máquina.",

  "action": {
    "default_popup": "popup.html",
    "default_title": "Conversor Local"
  },

  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "nativeMessaging"
  ],

  "optional_host_permissions": [
    "*://*/*"
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}